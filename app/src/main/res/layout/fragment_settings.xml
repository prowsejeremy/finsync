<?xml version="1.0" encoding="utf-8"?>
<!-- Settings' top level (spec "Settings → Adapters"): one row per sub-menu. The server pill
     moved to Jellyfin's page, fragment_sync_settings.xml (T4). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- Library: the folder the player reads, "Media/hz · 5,300 songs" (T3) -->
            <include
                android:id="@+id/rowLibrary"
                layout="@layout/view_settings_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <!-- Adapters: "Jellyfin · Synced · 1,400 of 1,400 songs", live (T4) -->
            <include
                android:id="@+id/rowAdapters"
                layout="@layout/view_settings_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <!-- Appearance: "Dark · Green" -->
            <include
                android:id="@+id/rowAppearance"
                layout="@layout/view_settings_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <!-- Home screen: which categories Home shows, and their order (3b refinements) -->
            <include
                android:id="@+id/rowHomeScreen"
                layout="@layout/view_settings_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <!-- Equaliser: "Off" or "On · Bass boost" (5) -->
            <include
                android:id="@+id/rowEqualiser"
                layout="@layout/view_settings_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
