<?xml version="1.0" encoding="utf-8"?>
<!-- Jellyfin sign-in (spec "Quick Connect sign-in"): the server URL, then one of two forms.
     Quick Connect shows first; LoginViewModel holds which form shows. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:gravity="center_horizontal">

        <!-- Logo -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="120dp"
            android:src="@drawable/ic_hz"
            android:contentDescription="@string/app_name" />

        <!-- App name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="36sp"
            android:fontFamily="@font/hk_extrabold"
            android:layout_marginBottom="80dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect to your Jellyfin server"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:fontFamily="@font/hk_regular"
            android:layout_marginBottom="20dp" />

        <!-- Server URL, shared by both forms -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_server_url"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxBackgroundColor="@color/bg_primary"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/hk_regular">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:imeOptions="actionNext"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quick Connect: Get code, then the code to approve in a signed-in Jellyfin app -->
        <LinearLayout
            android:id="@+id/quickConnectForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/codeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvQuickConnectCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="40sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/hk_extrabold"
                    android:textIsSelectable="true"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_connect_hint"
                    android:textColor="@color/muted"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:fontFamily="@font/hk_regular"
                    android:layout_marginBottom="20dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressQuickConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGetCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_get_code"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:backgroundTint="@color/surface_2"
                app:cornerRadius="28dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/hk_regular" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_cancel_code"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:backgroundTint="@color/surface_2"
                app:cornerRadius="28dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/hk_regular"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/linkUsePassword"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/link_use_password"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp"
                android:fontFamily="@font/hk_regular"
                android:layout_marginBottom="48dp" />
        </LinearLayout>

        <!-- Username and password: today's form, behind the link -->
        <LinearLayout
            android:id="@+id/passwordForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <!-- Username -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_username"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="@color/bg_primary"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/hk_regular">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionNext"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_password"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:endIconMode="password_toggle"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="@color/bg_primary"
                android:layout_marginBottom="28dp"
                android:fontFamily="@font/hk_regular">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- Sign In button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_login"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:backgroundTint="@color/surface_2"
                app:cornerRadius="28dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/hk_regular" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/linkUseQuickConnect"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/link_use_quick_connect"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp"
                android:fontFamily="@font/hk_regular"
                android:layout_marginBottom="48dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
