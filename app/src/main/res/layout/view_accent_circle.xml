<?xml version="1.0" encoding="utf-8"?>
<!-- One Appearance accent: a 32dp circle in that accent (AppearanceFragment colours it), and the
     ring shown when it's the chosen one. 44dp wide, so circles side by side are 12dp apart. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="44dp"
    android:layout_height="48dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackgroundBorderless">

    <View
        android:id="@+id/accentRing"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:background="@drawable/ring_selected"
        android:visibility="invisible" />

    <View
        android:id="@+id/accentDot"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:background="@drawable/circle_accent" />

</FrameLayout>
