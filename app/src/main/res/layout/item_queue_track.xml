<?xml version="1.0" encoding="utf-8"?>
<!-- A queue row: title, artist, duration and drag handle (queue editing spec). The background
     hides the rows beneath while one is dragged; the ripple is drawn over it. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:paddingStart="24dp"
    android:paddingEnd="12dp"
    android:paddingVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@color/surface_1"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:fontFamily="@font/hk_regular"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:fontFamily="@font/hk_regular"
            android:singleLine="true"
            android:ellipsize="end" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:fontFamily="@font/hk_regular" />

    <!-- 24dp icon in a 48dp touch target -->
    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:padding="12dp"
        android:src="@drawable/ic_drag_handle"
        android:contentDescription="@string/cd_drag_to_reorder"
        app:tint="@color/muted" />

</LinearLayout>
