<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.jpd.finsync.ui.HomeFragment">
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settings_graph" />
        <action
            android:id="@+id/action_home_to_albums"
            app:destination="@id/albumsFragment" />
        <action
            android:id="@+id/action_home_to_album_artists"
            app:destination="@id/albumArtistsFragment" />
        <action
            android:id="@+id/action_home_to_genres"
            app:destination="@id/genresFragment" />
        <action
            android:id="@+id/action_home_to_songs"
            app:destination="@id/songsFragment" />
        <action
            android:id="@+id/action_home_to_playlists"
            app:destination="@id/playlistsFragment" />
        <action
            android:id="@+id/action_home_to_audio_books"
            app:destination="@id/audioBooksFragment" />
    </fragment>

    <fragment
        android:id="@+id/albumsFragment"
        android:name="com.jpd.finsync.ui.AlbumsFragment">
        <action
            android:id="@+id/action_albums_to_album"
            app:destination="@id/albumFragment" />
    </fragment>

    <fragment
        android:id="@+id/albumFragment"
        android:name="com.jpd.finsync.ui.AlbumFragment">
        <argument
            android:name="albumId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/albumArtistsFragment"
        android:name="com.jpd.finsync.ui.AlbumArtistsFragment">
        <action
            android:id="@+id/action_album_artists_to_group"
            app:destination="@id/groupFragment" />
    </fragment>

    <fragment
        android:id="@+id/genresFragment"
        android:name="com.jpd.finsync.ui.GenresFragment">
        <action
            android:id="@+id/action_genres_to_group"
            app:destination="@id/groupFragment" />
    </fragment>

    <fragment
        android:id="@+id/songsFragment"
        android:name="com.jpd.finsync.ui.SongsFragment" />

    <!-- An artist's or genre's page; groupType is "artist" or "genre" -->
    <fragment
        android:id="@+id/groupFragment"
        android:name="com.jpd.finsync.ui.GroupFragment">
        <argument
            android:name="groupType"
            app:argType="string" />
        <argument
            android:name="groupId"
            app:argType="string" />
        <action
            android:id="@+id/action_group_to_all_songs"
            app:destination="@id/allSongsFragment" />
        <action
            android:id="@+id/action_group_to_album"
            app:destination="@id/albumFragment" />
    </fragment>

    <fragment
        android:id="@+id/allSongsFragment"
        android:name="com.jpd.finsync.ui.AllSongsFragment">
        <argument
            android:name="groupType"
            app:argType="string" />
        <argument
            android:name="groupId"
            app:argType="string" />
    </fragment>

    <!-- Opens the Player from the mini-player on any screen, including inside settings_graph -->
    <action
        android:id="@+id/action_global_player"
        app:destination="@id/playerFragment"
        app:enterAnim="@anim/slide_up"
        app:exitAnim="@anim/hold"
        app:popEnterAnim="@anim/hold"
        app:popExitAnim="@anim/slide_down" />

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.jpd.finsync.ui.PlayerFragment">
        <!-- The album replaces the Player rather than stacking above it -->
        <action
            android:id="@+id/action_player_to_album"
            app:destination="@id/albumFragment"
            app:popUpTo="@id/playerFragment"
            app:popUpToInclusive="true" />
        <!-- So does a book's page (3b) -->
        <action
            android:id="@+id/action_player_to_book"
            app:destination="@id/bookFragment"
            app:popUpTo="@id/playerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/playlistsFragment"
        android:name="com.jpd.finsync.ui.PlaylistsFragment">
        <action
            android:id="@+id/action_playlists_to_playlist"
            app:destination="@id/playlistFragment" />
    </fragment>

    <fragment
        android:id="@+id/playlistFragment"
        android:name="com.jpd.finsync.ui.PlaylistFragment">
        <argument
            android:name="playlistId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/audioBooksFragment"
        android:name="com.jpd.finsync.ui.AudioBooksFragment">
        <action
            android:id="@+id/action_audio_books_to_book"
            app:destination="@id/bookFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookFragment"
        android:name="com.jpd.finsync.ui.BookFragment">
        <argument
            android:name="bookId"
            app:argType="string" />
    </fragment>

    <!-- Nested so SettingsViewModel lives exactly as long as you're in Settings, and so the
         sync notification's deep link builds the Home → Settings back stack. -->
    <navigation
        android:id="@+id/settings_graph"
        app:startDestination="@id/settingsFragment">

        <fragment
            android:id="@+id/settingsFragment"
            android:name="com.jpd.finsync.ui.SettingsFragment">
            <action
                android:id="@+id/action_settings_to_downloads"
                app:destination="@id/downloadsFragment" />
            <action
                android:id="@+id/action_settings_to_album_selection"
                app:destination="@id/albumSelectionFragment" />
            <action
                android:id="@+id/action_settings_to_auto_sync"
                app:destination="@id/autoSyncFragment" />
            <action
                android:id="@+id/action_settings_to_playlist_selection"
                app:destination="@id/playlistSelectionFragment" />
            <action
                android:id="@+id/action_settings_to_book_selection"
                app:destination="@id/bookSelectionFragment" />
        </fragment>

        <fragment
            android:id="@+id/downloadsFragment"
            android:name="com.jpd.finsync.ui.DownloadsFragment" />

        <fragment
            android:id="@+id/albumSelectionFragment"
            android:name="com.jpd.finsync.ui.AlbumSelectionFragment" />

        <fragment
            android:id="@+id/autoSyncFragment"
            android:name="com.jpd.finsync.ui.AutoSyncFragment" />

        <fragment
            android:id="@+id/playlistSelectionFragment"
            android:name="com.jpd.finsync.ui.PlaylistSelectionFragment" />

        <fragment
            android:id="@+id/bookSelectionFragment"
            android:name="com.jpd.finsync.ui.BookSelectionFragment" />

    </navigation>

</navigation>
