<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The one app theme (spec "Resources"). DayNight takes values-night/ colours in dark mode.
         The accent comes from an overlay below; without one it's Green. -->
    <style name="Theme.Finsync" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorOnPrimary">@color/on_accent_green</item>
        <item name="colorSurface">@color/surface_1</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_2</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/muted</item>
        <item name="elevationOverlayEnabled">false</item>
        <!-- Prevents the white flash on startup before the activity renders -->
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/surface_2</item>
        <!-- Dark status-bar icons in light mode, light ones in dark mode -->
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>

        <!-- Default Font -->
        <item name="android:fontFamily">@font/hk_regular</item>
    </style>

    <!-- Bottom sheet theme for every sheet's getTheme(). An overlay, so each sheet keeps its
         activity's mode and accent. -->
    <style name="Theme.Finsync.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorSurface">@color/surface_1</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="bottomSheetStyle">@style/Widget.Finsync.BottomSheet</item>
        <!-- The Material 3 overlay turns edge-to-edge on; the sheets have never drawn under the
             navigation bar -->
        <item name="enableEdgeToEdge">false</item>
        <!-- The overlay's dialog parent makes a plain MaterialButton a flush text button; the
             speed chips and Log out have always used the filled default -->
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>

        <!-- Default Font -->
        <item name="android:fontFamily">@font/hk_regular</item>
    </style>
    <style name="Widget.Finsync.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_1</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Finsync.BottomSheet</item>
    </style>
    <style name="ShapeAppearance.Finsync.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- LoginActivity: its text fields sit on the page colour -->
    <style name="Theme.Finsync.Login" parent="Theme.Finsync">
        <item name="colorSurface">@color/bg_primary</item>
        <!-- colorOutline (the base theme's muted) drives the unfocused field border -->
        <item name="colorSurfaceVariant">@color/surface_1</item>
    </style>

    <!-- Accent overlays, one per Appearance choice, each laid over Theme.Finsync. Only these and
         Theme.Finsync name the accent_* colours; layouts, drawables and code use
         ?attr/colorPrimary and ?attr/colorOnPrimary. The mode picks the dark or light value. -->
    <style name="ThemeOverlay.Finsync.Accent.Green" parent="">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorOnPrimary">@color/on_accent_green</item>
    </style>
    <style name="ThemeOverlay.Finsync.Accent.Blue" parent="">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/on_accent_blue</item>
    </style>
    <style name="ThemeOverlay.Finsync.Accent.Purple" parent="">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/on_accent_purple</item>
    </style>
    <style name="ThemeOverlay.Finsync.Accent.Pink" parent="">
        <item name="colorPrimary">@color/accent_pink</item>
        <item name="colorOnPrimary">@color/on_accent_pink</item>
    </style>
    <style name="ThemeOverlay.Finsync.Accent.Red" parent="">
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorOnPrimary">@color/on_accent_red</item>
    </style>
</resources>
